
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WasteWise Management System</title>

<style>
* {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    margin: 0;
    background: #f2f6f8;
    color: #203b37;
    font-size: 13px;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    cursor: pointer;
    border: none;
    border-radius: 4px;
    padding: 10px 14px;
    background: #00875a;
    color: white;
}

button:hover {
    background: #006747;
}

input, select {
    padding: 10px;
    border: 1px solid #dce5e7;
    border-radius: 4px;
    background: white;
    outline: none;
}

input:focus, select:focus {
    border-color: #00875a;
}

/* PAGE NAVIGATION */
.page {
    display: none;
}

.page:target {
    display: block;
}

body:not(:has(.page:target)) #login {
    display: block;
}

/* LOGIN DESIGN */
.auth {
    display: flex;
    max-width: 850px;
    min-height: 480px;
    margin: 40px auto;
    background: white;
    border-radius: 8px;
    overflow: hidden;
}

.auth-left {
    width: 40%;
    padding: 30px;
    background: #006747;
    color: white;
}

.auth-left h1 {
    font-size: 28px;
    margin-top: 50px;
}

.auth-left .truck-art {
    font-size: 65px;
    text-align: center;
    margin: 30px 0;
}

.auth-right {
    width: 60%;
    padding: 35px;
}

.auth-form {
    max-width: 330px;
    margin: 30px auto;
}

.auth-form h2 {
    font-size: 22px;
}

.auth-form input {
    width: 100%;
    margin: 7px 0 12px;
}

.auth-form button {
    width: 100%;
    margin-top: 12px;
}

.auth-form p, .auth-form .links {
    color: #71817e;
    font-size: 12px;
}

.links {
    margin-top: 18px;
    text-align: center;
}

.links a {
    color: #00875a;
}

/* DASHBOARD LAYOUT */
.dashboard {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 205px;
    flex-shrink: 0;
    background: #005b43;
    color: #d7eee6;
    display: flex;
    flex-direction: column;
}

.brand {
    padding: 23px 20px;
    font-size: 19px;
    font-weight: bold;
    color: white;
}

.menu-title {
    padding: 12px 20px 5px;
    color: #8fc7b3;
    font-size: 10px;
}

.menu a {
    display: block;
    padding: 12px 20px;
    font-size: 12px;
    border-left: 3px solid transparent;
}

.menu a:hover, .menu a.active {
    background: #087455;
    color: white;
    border-left-color: #49d5a1;
}

.sidebar-bottom {
    margin-top: auto;
    padding: 18px;
    border-top: 1px solid #26745e;
    font-size: 11px;
}

.main {
    min-width: 0;
    flex: 1;
}

.topbar {
    height: 55px;
    padding: 0 25px;
    background: white;
    border-bottom: 1px solid #e8eeee;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #748580;
    font-size: 11px;
}

.topbar .user {
    color: #263d37;
}

.content {
    padding: 25px;
}

.heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 25px;
}

.heading h1 {
    font-size: 23px;
    margin: 0 0 7px;
}

.heading p {
    color: #82918d;
    margin: 0;
    font-size: 12px;
}

.btn-green {
    background: #00875a;
    color: white;
}

.btn-light {
    background: white;
    border: 1px solid #dce5e7;
    color: #334a44;
}

.btn-light:hover {
    background: #eef7f3;
}

/* TABS */
.tabs {
    display: flex;
    gap: 22px;
    border-bottom: 1px solid #dce5e7;
    margin-bottom: 18px;
}

.tabs a {
    padding: 10px 0;
    color: #748580;
}

.tabs a:first-child {
    color: #00875a;
    border-bottom: 2px solid #00875a;
}

/* FILTERS */
.filters {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 20px;
}

.filters input {
    flex: 1;
    min-width: 150px;
}

.filters select {
    min-width: 100px;
}

/* CARDS */
.card {
    background: white;
    border: 1px solid #e5ebec;
    border-radius: 5px;
    padding: 16px;
}

.card-title {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 15px;
}

.routes-layout {
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
    gap: 15px;
}

.route-item {
    padding: 13px 0;
    border-bottom: 1px solid #edf0f0;
}

.route-item:last-child {
    border-bottom: none;
}

.route-name {
    color: #00875a;
    font-weight: bold;
    margin-bottom: 7px;
}

.small {
    color: #81918c;
    font-size: 11px;
    line-height: 1.7;
}

.status {
    display: inline-block;
    padding: 5px 8px;
    border-radius: 4px;
    font-size: 10px;
    background: #e0f7e9;
    color: #168653;
}

.status.orange {
    background: #fff0d9;
    color: #b7791f;
}

.status.gray {
    background: #edf0f2;
    color: #65736e;
}

/* ROUTE MAP */
.map {
    height: 400px;
    position: relative;
    overflow: hidden;
    background-color: #f0f2e9;
    background-image:
        linear-gradient(90deg, transparent 96%, #ffffff 96%),
        linear-gradient(transparent 96%, #ffffff 96%);
    background-size: 65px 55px;
    border-radius: 4px;
}

.park {
    position: absolute;
    background: #d8e9ce;
    border-radius: 4px;
}

.road {
    position: absolute;
    height: 3px;
    background: #e9c98c;
    transform-origin: left center;
}

.route-line {
    position: absolute;
    height: 3px;
    background: #00a978;
    transform-origin: left center;
}

.pin {
    position: absolute;
    width: 19px;
    height: 19px;
    background: #00875a;
    color: white;
    border: 2px solid white;
    border-radius: 4px;
    text-align: center;
    line-height: 15px;
    font-weight: bold;
    font-size: 10px;
    z-index: 2;
}

.map-label {
    position: absolute;
    color: #88958b;
    font-size: 10px;
}

.map-controls {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: grid;
    gap: 4px;
}

.map-controls button {
    padding: 7px 12px;
    color: #203b37;
    background: white;
    border: 1px solid #ddd;
}

/* TRUCK TABLE */
.table-wrap {
    overflow-x: auto;
    background: white;
    border: 1px solid #e5ebec;
    border-radius: 5px;
}

table {
    border-collapse: collapse;
    width: 100%;
    text-align: left;
    white-space: nowrap;
}

th {
    background: #f7f9fa;
    color: #788984;
    font-size: 11px;
    font-weight: normal;
}

th, td {
    padding: 15px 12px;
    border-bottom: 1px solid #edf0f0;
}

td {
    font-size: 12px;
}

tbody tr:hover {
    background: #f7fbf9;
}

.truck-id {
    color: #00875a;
    font-weight: bold;
}

.driver {
    display: flex;
    align-items: center;
    gap: 8px;
}

.avatar {
    width: 27px;
    height: 27px;
    background: #dcefe7;
    border-radius: 50%;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    color: #00734e;
    font-weight: bold;
}

.table-bottom {
    padding: 14px;
    display: flex;
    justify-content: space-between;
    color: #84928e;
    font-size: 11px;
    background: white;
}

@media(max-width: 900px) {
    .sidebar {
        width: 155px;
    }

    .routes-layout {
        grid-template-columns: 1fr;
    }

    .content {
        padding: 16px;
    }
}

@media(max-width: 600px) {
    .dashboard {
        display: block;
    }

    .sidebar {
        width: 100%;
    }

    .brand {
        padding: 15px;
    }

    .menu {
        display: flex;
        overflow-x: auto;
    }

    .menu-title, .sidebar-bottom {
        display: none;
    }

    .menu a {
        white-space: nowrap;
        padding: 12px;
    }

    .topbar {
        padding: 0 12px;
    }

    .heading h1 {
        font-size: 19px;
    }

    .auth {
        flex-direction: column;
        margin: 15px;
    }

    .auth-left, .auth-right {
        width: 100%;
    }

    .auth-left h1 {
        margin-top: 20px;
    }
}
</style>
</head>

